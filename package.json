{
    "name": "code-atlas-hub",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "start": "webpack serve --env port=3000",
        "start:dev": "concurrently \"npm start\" \"npm run start:dev:server\"",
        "start:dev:server": "node ./json-server/index.mjs",
        "build:prod": "webpack --env mode=production",
        "build:dev": "webpack --env mode=development",
        "lint:ts": "npx eslint '**/*.{js,mjs,cjs,ts,jsx,tsx}'",
        "lint:ts:fix": "npx eslint '**/*.{js,mjs,cjs,ts,jsx,tsx}' --fix",
        "lint:scss": "npx stylelint '**/*.scss'",
        "lint:scss:fix": "npx stylelint '**/*.scss' --fix",
        "test:unit": "jest --config ./config/jest/jest.config.ts",
        "test:ui": "npx loki test",
        "test:ui:ok": "npx loki approve",
        "storybook": "storybook dev -p 6006 --config-dir=config/storybook",
        "storybook:build": "storybook build --config-dir=config/storybook",
        "prepare": "husky install",
        "format:prettier": "prettier --write .",
        "format:prettier:check": "prettier --check ."
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "npm run lint:ts:fix",
            "prettier --write"
        ],
        "*.scss": [
            "npm run lint:scss:fix"
        ]
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@chromatic-com/storybook": "^3.2.6",
        "@eslint/js": "^9.22.0",
        "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
        "@storybook/addon-essentials": "^8.6.7",
        "@storybook/addon-interactions": "^8.6.7",
        "@storybook/addon-onboarding": "^8.6.7",
        "@storybook/addon-webpack5-compiler-swc": "^3.0.0",
        "@storybook/blocks": "^8.6.7",
        "@storybook/react": "^8.6.7",
        "@storybook/react-webpack5": "^8.6.7",
        "@storybook/test": "^8.6.7",
        "@svgr/webpack": "^8.1.0",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.13.9",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@types/webpack": "^5.28.5",
        "@types/webpack-bundle-analyzer": "^4.7.0",
        "@types/webpack-dev-server": "^4.7.2",
        "copy-webpack-plugin": "^13.0.0",
        "css-loader": "^7.1.2",
        "eslint": "^9.22.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-i18next": "^6.1.1",
        "eslint-plugin-prettier": "^5.4.0",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-storybook": "^0.11.6",
        "eslint-plugin-unused-imports": "^4.1.4",
        "file-loader": "^6.2.0",
        "globals": "^16.0.0",
        "html-webpack-plugin": "^5.6.3",
        "husky": "^9.1.7",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "json-server": "^0.17.4",
        "lint-staged": "^15.5.0",
        "loki": "^0.35.1",
        "mini-css-extract-plugin": "^2.9.2",
        "prettier": "^3.5.3",
        "react-refresh": "^0.16.0",
        "sass": "^1.85.1",
        "sass-loader": "^16.0.5",
        "storybook": "^8.6.7",
        "style-loader": "^4.0.0",
        "stylelint": "^16.15.0",
        "stylelint-config-standard-scss": "^14.0.0",
        "stylelint-order": "^6.0.4",
        "ts-jest": "^29.2.6",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.1",
        "webpack": "^5.98.0",
        "webpack-bundle-analyzer": "^4.10.2",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.0"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.0.1",
        "@react-oauth/google": "^0.12.2",
        "@reduxjs/toolkit": "^2.6.1",
        "axios": "^1.8.4",
        "concurrently": "^9.1.2",
        "i18next": "^24.2.2",
        "i18next-browser-languagedetector": "^8.0.4",
        "i18next-http-backend": "^3.0.2",
        "jsonwebtoken": "^9.0.2",
        "jwt-decode": "^4.0.0",
        "lucide-react": "^0.479.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.55.0",
        "react-i18next": "^15.4.1",
        "react-redux": "^9.2.0",
        "react-router-dom": "^7.3.0",
        "yup": "^1.6.1"
    },
    "eslintConfig": {
        "extends": [
            "plugin:storybook/recommended"
        ]
    },
    "loki": {
        "configurations": {
            "chrome.laptop": {
                "target": "chrome.app",
                "width": 1366,
                "height": 768,
                "deviceScaleFactor": 1,
                "mobile": false
            },
            "chrome.iphone7": {
                "target": "chrome.app",
                "preset": "iPhone 7"
            }
        }
    }
}
